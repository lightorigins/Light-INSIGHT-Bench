{
  "$defs": {
    "RegistryEntry": {
      "additionalProperties": false,
      "properties": {
        "benchmark_id": {
          "title": "Benchmark Id",
          "type": "string"
        },
        "manifest_path": {
          "title": "Manifest Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "benchmark_id",
        "version",
        "manifest_path",
        "sha256"
      ],
      "title": "RegistryEntry",
      "type": "object"
    }
  },
  "$id": "https://www.lightorigins.com/schemas/insight-bench/v1/registry.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "$ref": "#/$defs/RegistryEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "registry_version": {
      "title": "Registry Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "registry_version",
    "entries"
  ],
  "title": "RegistryContract",
  "type": "object"
}
