{
  "$defs": {
    "EvidenceArtifact": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "role": {
          "enum": [
            "run-result",
            "supporting"
          ],
          "title": "Role",
          "type": "string"
        },
        "sanitization": {
          "enum": [
            "structured-redaction",
            "text-redaction",
            "binary-none"
          ],
          "title": "Sanitization",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "media_type",
        "role",
        "sanitization"
      ],
      "title": "EvidenceArtifact",
      "type": "object"
    }
  },
  "$id": "https://www.lightorigins.com/schemas/insight-bench/v1/evidence-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/EvidenceArtifact"
      },
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "pack_id": {
      "title": "Pack Id",
      "type": "string"
    },
    "redactions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Redactions",
      "type": "array"
    },
    "run_fingerprint": {
      "title": "Run Fingerprint",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{16}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "pack_id",
    "run_id",
    "run_fingerprint",
    "artifacts"
  ],
  "title": "EvidenceManifest",
  "type": "object"
}
