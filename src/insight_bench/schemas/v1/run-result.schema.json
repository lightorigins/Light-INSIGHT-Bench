{
  "$defs": {
    "AdapterAction": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "AdapterAction",
      "type": "object"
    },
    "AdapterDescriptor": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "title": "Adapter Id",
          "type": "string"
        },
        "deterministic": {
          "default": false,
          "title": "Deterministic",
          "type": "boolean"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "model_id": {
          "title": "Model Id",
          "type": "string"
        },
        "protocol_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Protocol Version",
          "type": "string"
        }
      },
      "required": [
        "adapter_id",
        "model_id"
      ],
      "title": "AdapterDescriptor",
      "type": "object"
    },
    "AdapterResponse": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AdapterAction"
          },
          "title": "Actions",
          "type": "array"
        },
        "adapter": {
          "$ref": "#/$defs/AdapterDescriptor"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "output": {
          "default": "",
          "title": "Output",
          "type": "string"
        },
        "request_id": {
          "pattern": "^req-[0-9a-f]{16}$",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "success",
            "error"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "adapter",
        "status"
      ],
      "title": "AdapterResponse",
      "type": "object"
    },
    "EpisodeRunResult": {
      "additionalProperties": false,
      "properties": {
        "episode_id": {
          "title": "Episode Id",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "metrics": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Metrics",
          "type": "object"
        },
        "response": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdapterResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "episode_id",
        "task_id",
        "status"
      ],
      "title": "EpisodeRunResult",
      "type": "object"
    },
    "RuntimeAttestation": {
      "additionalProperties": false,
      "description": "Where and how a simulator run actually executed.\n\nPublication policy (ADR 0008, 2026-09): a run is leaderboard-eligible\nwhen it executed on an *official* backend, on Linux -- in a container or\nnatively -- and its NVIDIA driver version was actually recorded, as a\ndotted-numeric version such as ``535.216.03`` (the same rule the\nofficial-profile gate applies; a placeholder like ``unknown`` is not a\nrecorded driver). The driver version is evidence, not a floor: nothing\ncompares it against a minimum. ``image_digest`` and ``digest_locked`` are optional,\ninformational fields that gate nothing; the runtime image embeds NVIDIA\nIsaac Sim and cannot be redistributed, so no published digest exists for\na run to be locked to. Windows runs and experimental backends are\ndevelopment and debugging support and must carry ``publishable: false``;\nsubmission validation may reject formal publication on this record. The\nin-model validator enforces the necessary conditions; the check of\n``backend_id`` against the registry descriptor happens in the\nofficial-profile gate.",
      "properties": {
        "backend_id": {
          "title": "Backend Id",
          "type": "string"
        },
        "backend_status": {
          "enum": [
            "official",
            "experimental"
          ],
          "title": "Backend Status",
          "type": "string"
        },
        "digest_locked": {
          "default": false,
          "title": "Digest Locked",
          "type": "boolean"
        },
        "driver_version": {
          "default": "",
          "title": "Driver Version",
          "type": "string"
        },
        "image_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Digest"
        },
        "isaac_lab_version": {
          "default": "",
          "title": "Isaac Lab Version",
          "type": "string"
        },
        "isaac_sim_version": {
          "default": "",
          "title": "Isaac Sim Version",
          "type": "string"
        },
        "launcher_id": {
          "title": "Launcher Id",
          "type": "string"
        },
        "os": {
          "enum": [
            "linux",
            "windows"
          ],
          "title": "Os",
          "type": "string"
        },
        "publishable": {
          "default": false,
          "title": "Publishable",
          "type": "boolean"
        },
        "python_version": {
          "default": "",
          "title": "Python Version",
          "type": "string"
        },
        "runtime_kind": {
          "enum": [
            "docker",
            "native"
          ],
          "title": "Runtime Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "backend_id",
        "backend_status",
        "launcher_id",
        "runtime_kind",
        "os"
      ],
      "title": "RuntimeAttestation",
      "type": "object"
    }
  },
  "$id": "https://www.lightorigins.com/schemas/insight-bench/v1/run-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter": {
      "$ref": "#/$defs/AdapterDescriptor"
    },
    "benchmark_id": {
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_version": {
      "title": "Benchmark Version",
      "type": "string"
    },
    "episodes": {
      "items": {
        "$ref": "#/$defs/EpisodeRunResult"
      },
      "minItems": 1,
      "title": "Episodes",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Metrics",
      "type": "object"
    },
    "run_fingerprint": {
      "title": "Run Fingerprint",
      "type": "string"
    },
    "run_id": {
      "pattern": "^run-[0-9a-f]{16}$",
      "title": "Run Id",
      "type": "string"
    },
    "runtime_attestation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeAttestation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "maximum": 4294967295,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "run_fingerprint",
    "benchmark_id",
    "benchmark_version",
    "adapter",
    "seed",
    "status",
    "episodes",
    "metrics"
  ],
  "title": "RunResult",
  "type": "object"
}
